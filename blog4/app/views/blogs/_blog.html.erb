<div id="<%= dom_id blog %>">

  <p>
    <strong>Title:</strong>
    <%= blog.title %>
  </p>

  <p>
    <strong>Content:</strong>
    <%= blog.content %>
  </p>

  <p>
    <strong>Author:</strong>
    <%= blog.user.username %>
  </p>

  <p>
    <strong>Created at:</strong>
    <%= blog.created_at %>
  </p>

</div>

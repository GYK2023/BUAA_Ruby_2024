<p style="color: green"><%= notice %></p>

<%= render @blog %>

<div>
  <% if @blog.user.username == current_user.username %>
    <%= link_to "Edit this blog", edit_user_blog_path(@blog) %> |
  <% end %>
  
  <%= link_to "Back to blogs", user_blogs_path(current_user.username) %>

  <% if @blog.user.username == current_user.username %>
    <%= button_to "Destroy this blog", user_blog_path(@blog), method: :delete %>
  <% end %>
</div>

<h2>Comments</h2>
<div id="comments">
  <%= render @blog.comments %>
</div>
<%= form_with model: [current_user, @blog, Comment.new] do |f| %>
  <p>
    <%= f.label :content, "New Comment" %> <br />
    <%= f.text_area :content, :rows => 5 %>
  </p>
  <p><%= f.submit "Add Comment" %></p>
<% end %>


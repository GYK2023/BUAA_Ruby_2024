261:            </svg>
262:          </div>
263:          <h2>购物车是空的</h2>
264:          <p>快去挑选心仪的商品吧！</p>
265:          <%= link_to '去购物', products_path, class: 'shop-now-btn' %>
266:        </div>
267:      <% end %>
268:      <% end %>
269:    </div>

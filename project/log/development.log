225:    <body>
226:    <div class="favorites-container">
227:      <h1>我的收藏夹</h1>
228:    
229:      <% if @favorites.any? %>
230:        <div class="favorites-list">
231:          <% @favorites.each do |favorite| %>
232:            <div class="favorite-item">
233:              <div class="product-image">
234:                <%= link_to product_path(favorite.product) do %>
235:                  <%= image_tag favorite.product.image, class: "product-image-img" %>
236:                <% end %>
237:              </div>
238:    
239:              <div class="product-info">
240:                <h3><%= link_to favorite.product.name, product_path(favorite.product) %></h3>
241:                <p><strong>价格:</strong> ￥<%= favorite.product.price %></p>
242:                <p><strong>描述:</strong> <%= truncate(favorite.product.description, length: 100) %></p>
243:              </div>
244:    
245:              <div class="actions">
246:                <%= button_to favorite_path(favorite), 
247:                    method: :delete, 
248:                    remote: true, 
249:                    class: "btn btn-danger" do %>
250:                  移除收藏
251:                <% end %>
252:              </div>
253:            </div>
254:          <% end %>
255:        </div>
256:      <% else %>
257:        <div class="empty-cart">
258:          <div class="cart-icon">
259:            <svg viewBox="0 0 24 24" width="64" height="64">

<div class="container my-5">
  <div class="page-header">
    <h1>我的地址</h1>
    <div class="header-line"></div>
  </div>

  <!-- 显示当前用户的所有地址 -->
  <% if @addresses.any? %>
    <div class="address-list">
      <div class="quick-add">
        <%= link_to new_address_path, class: "add-new-btn" do %>
          <span class="plus-icon">+</span>
          <span>添加新地址</span>
        <% end %>
      </div>
      
      <% @addresses.each do |address| %>
        <div class="address-card <%= 'default-address' if address.default %>">
          <div class="card-content">
            <div class="address-info">
              <div class="user-info">
                <h3 class="name"><%= address.name %></h3>
                <span class="phone"><%= address.phone_num %></span>
                <% if address.default %>
                  <span class="default-badge">默认</span>
                <% end %>
              </div>
              
              <div class="address-detail">
                <i class="location-icon">📍</i>
                <p><%= address.address %></p>
              </div>
            </div>
            
            <div class="address-actions">
              <%= link_to edit_address_path(address), class: "edit-btn" do %>
                <span>编辑</span>
              <% end %>
              
              <%= button_to address_path(address), 
                    method: :delete, 
                    class: "delete-btn",
                    data: { 
                      confirm: "确认删除这个地址吗？",
                      turbo_confirm: "确认删除这个地址吗？"
                    } do %>
                <span>删除</span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-illustration">
        <div class="location-pin">
          <svg viewBox="0 0 24 24" width="80" height="80">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zM12 11.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="#999"/>
          </svg>
        </div>
      </div>
      <h2>还没有添加地址</h2>
      <p>快去添加我的地址</p>
      <%= link_to new_address_path, class: "add-first-btn" do %>
        <span class="plus-icon">+</span>
        <span>添加地址</span>
      <% end %>
    </div>
  <% end %>
</div>

<style>
:root {
  --primary-color: #4a90e2;
  --secondary-color: #34495e;
  --success-color: #2ecc71;
  --danger-color: #e74c3c;
  --light-gray: #f5f6fa;
  --border-radius: 12px;
  --card-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  --transition: all 0.3s ease;
}

.container {
  max-width: 1000px;
  margin: 0 auto;
  padding: 2rem;
}

.page-header {
  text-align: center;
  margin-bottom: 3rem;
}

.page-header h1 {
  color: var(--secondary-color);
  font-weight: 600;
  margin-bottom: 1rem;
}

.header-line {
  width: 60px;
  height: 4px;
  background: linear-gradient(90deg, var(--primary-color), var(--success-color));
  margin: 0 auto;
  border-radius: 2px;
}

.quick-add {
  margin-bottom: 2rem;
  text-align: right;
}

.add-new-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  background: var(--primary-color);
  color: white;
  border-radius: 25px;
  text-decoration: none;
  font-weight: 500;
  transition: var(--transition);
}

.add-new-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(74, 144, 226, 0.3);
  color: white;
}

.address-card {
  background: white;
  border-radius: var(--border-radius);
  box-shadow: var(--card-shadow);
  margin-bottom: 1.5rem;
  transition: var(--transition);
  border: 1px solid rgba(0, 0, 0, 0.08);
}

.address-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 25px rgba(0, 0, 0, 0.1);
}

.default-address {
  border: 2px solid var(--primary-color);
}

.card-content {
  padding: 1.5rem;
}

.address-info {
  margin-bottom: 1rem;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
}

.name {
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--secondary-color);
  margin: 0;
}

.phone {
  color: #666;
  font-size: 1rem;
}

.default-badge {
  background: rgba(74, 144, 226, 0.1);
  color: var(--primary-color);
  padding: 4px 12px;
  border-radius: 15px;
  font-size: 0.85rem;
  font-weight: 500;
}

.address-detail {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  color: #666;
  line-height: 1.5;
}

.location-icon {
  font-size: 1.2rem;
}

.address-actions {
  display: flex;
  gap: 1rem;
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px solid var(--light-gray);
}

.edit-btn, .delete-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  border-radius: 20px;
  border: none;
  font-size: 0.9rem;
  cursor: pointer;
  text-decoration: none;
  transition: var(--transition);
}

.edit-btn {
  background: var(--light-gray);
  color: var(--secondary-color);
}

.delete-btn {
  background: rgba(231, 76, 60, 0.1);
  color: var(--danger-color);
}

.edit-btn:hover, .delete-btn:hover {
  transform: translateY(-2px);
}

.empty-state {
  text-align: center;
  padding: 4rem 2rem;
  background: white;
  border-radius: var(--border-radius);
  box-shadow: var(--card-shadow);
}

.empty-illustration {
  margin-bottom: 2rem;
}

.location-pin {
  animation: float 3s ease-in-out infinite;
}

.location-pin svg {
  fill: var(--primary-color);
  opacity: 0.9;
}

.empty-state h2 {
  font-size: 1.5rem;
  color: var(--secondary-color);
  margin-bottom: 1rem;
}

.empty-state p {
  color: #666;
  margin-bottom: 2rem;
}

.add-first-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 32px;
  background: linear-gradient(135deg, var(--primary-color), #5b9eed);
  color: white;
  border-radius: 25px;
  text-decoration: none;
  font-weight: 500;
  transition: var(--transition);
}

.add-first-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(74, 144, 226, 0.3);
  color: white;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-15px);
  }
}

@media (max-width: 768px) {
  .container {
    padding: 1rem;
  }
  
  
  .card-content {
    padding: 1rem;
  }
  
  .user-info {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
  
  .address-actions {
    flex-direction: column;
  }
  
  .edit-btn, .delete-btn {
    width: 100%;
    justify-content: center;
  }
  
  .quick-add {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  
  .add-new-btn {
    width: 100%;
    justify-content: center;
  }
}
</style>
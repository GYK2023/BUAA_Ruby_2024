<div class="container">
  <h1 class="text-center mb-4">所有产品</h1>

  <!-- 新增产品的按钮 -->
  <% if current_user.is_admin? %>
     <div class="mb-4 text-center">
        <%= link_to '新增产品', new_product_path, class: "btn btn-success btn-lg" %>
    </div>
  <% end %>
  
  <div class="product-grid">
    <% @products.each do |product| %>
      <div class="product-card">
        <%= link_to product_path(product), class: "product-link" do %>
          <div class="product-image">
            <% if product.image.attached? %>
              <%= image_tag product.image, class: "img-fluid product-image-img" %>
            <% else %>
              <img src="default-image.jpg" alt="No image" class="img-fluid product-image-img">
            <% end %>
          </div>
          <div class="product-details">
            <h3 class="product-title"><%= product.name %></h3>
            <p class="price">￥<%= product.price %></p>
            <p class="stock">库存: <%= product.stock %></p>
            <p class="sales">销量: <%= product.sales %></p>
          </div>
        <% end %>

        <div class="product-actions text-center">
          <%= link_to '查看产品', product_path(product), class: "btn btn-primary btn-sm m-1" %>
          <%= link_to '加入购物车', "#", class: "btn btn-success btn-sm m-1" %>
          <%= link_to '收藏', "#", class: "btn btn-danger btn-sm m-1" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- 嵌入CSS样式 -->
<style>
  /* 让页面整体居中，保持良好的边距 */
  .container {
    margin-top: 40px;
  }

  /* 使标题居中 */
  h1 {
    font-size: 2.5rem;
    font-weight: bold;
    color: #333;
  }

  /* 增加产品网格的间距，保持适当的响应式布局 */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    padding: 20px;
  }

  /* 产品卡片的样式 */
  .product-card {
    background-color: #fff;
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  /* 产品卡片 hover 效果 */
  .product-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 6px 10px rgba(0, 0, 0, 0.15);
  }

  /* 产品图片的样式 */
  .product-image-img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    border-bottom: 1px solid #f0f0f0;
  }

  /* 产品详细信息 */
  .product-details {
    padding: 15px;
    text-align: center;
  }

  .product-title {
    font-size: 1.2rem;
    color: #333;
    margin-bottom: 10px;
  }

  .price {
    font-size: 1.3rem;
    font-weight: bold;
    color: #e74c3c;
    margin-bottom: 10px;
  }

  .stock, .sales {
    font-size: 1rem;
    color: #7f8c8d;
  }

  /* 产品卡片下方的按钮 */
  .product-actions {
    padding: 15px;
    background-color: #f9f9f9;
    border-top: 1px solid #f0f0f0;
  }

  .product-actions .btn {
    width: 100%;
    margin: 5px 0;
    padding: 10px;
    border-radius: 5px;
    font-size: 1rem;
    
  }

  .product-actions .btn-primary {
    background-color: #3498db;
    color: #fff;
  }

  .product-actions .btn-success {
    background-color: #2ecc71;
    color: #fff;
  }

  .product-actions .btn-danger {
    background-color: #e74c3c;
    color: #fff;
  }

  .product-actions .btn:hover {
    opacity: 0.8;
  }

  /* 增加“新增产品”按钮的样式 */
  .btn-success {
    background-color: #28a745;
    color: white;
    font-size: 1.2rem; /* 增大字体 */
    padding: 12px 20px;
    border-radius: 5px;
    text-transform: uppercase;
    font-weight: bold;
  }

  .btn-success:hover {
    background-color: #218838;
  }
</style>

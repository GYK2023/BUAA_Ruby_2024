
<div class="order-details">
  <h1>订单详情</h1>

  <div class="order-summary">
    <p><strong>订单编号</strong> <%= @order.id %></p>
    <p><strong>下单时间:</strong> <%= @order.created_at.in_time_zone("Beijing").strftime("%Y-%m-%d %H:%M:%S") %></p>
    <p><strong>收货地址</strong> <%= @order.address.address %></p>
    <p><strong>收货人姓名</strong> <%= @order.address.name %></p>
    <p><strong>联系电话</strong> <%= @order.address.phone_num %></p>
    <p>
      <strong>订单状态</strong>
      <span class="status-badge <%= @order.status.downcase %>">
        <%= @order.status %>
      </span>
    </p>
  </div>

  <div class="order-items">
    <h3>商品列表</h3>
    <table class="table">
      <thead>
        <tr>
          <th>商品名称</th>
          <th>单价</th>
          <th>数量</th>
          <th>小计</th>
        </tr>
      </thead>
      <tbody>
        <% @order.order_items.each do |item| %>
          <tr>
            <td><%= item.product.name %></td>
            <td>￥<%= number_with_precision(item.price, precision: 2) %></td>
            <td><%= item.quantity %></td>
            <td>￥<%= number_with_precision(item.price * item.quantity, precision: 2) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="total">
    <p>
      <strong>总计</strong>
      <span class="amount">
        ￥<%= number_with_precision(@order.order_items.sum { |item| item.price * item.quantity }, precision: 2) %>
      </span>
    </p>
  </div>
</div>

<style>
  .order-details {
    max-width: 900px;
    margin: 3rem auto;
    padding: 2.5rem;
    background: #fff;
    border-radius: 15px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.1);
  }

  .order-details h1 {
    color: #2c3e50;
    text-align: center;
    margin-bottom: 2.5rem;
    font-weight: 600;
    font-size: 2.2rem;
    position: relative;
  }

  .order-details h1:after {
    content: '';
    display: block;
    width: 60px;
    height: 4px;
    background: #3498db;
    margin: 1rem auto;
    border-radius: 2px;
  }

  .order-summary {
    background: #f8f9fa;
    padding: 2rem;
    border-radius: 12px;
    margin-bottom: 2.5rem;
    border-left: 5px solid #3498db;
    transition: all 0.3s ease;
  }

  .order-summary:hover {
    transform: translateX(5px);
  }

  .order-summary p {
    margin: 1rem 0;
    line-height: 1.8;
    display: flex;
    align-items: center;
  }

  .order-summary p strong {
    color: #2c3e50;
    min-width: 120px;
    margin-right: 1rem;
    position: relative;
  }

  .order-summary p strong:after {
    content: ':';
    position: absolute;
    right: 0;
  }

  .status-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .status-badge.pending {
    background: rgba(241, 196, 15, 0.2);
    color: #b7950b;
  }

  .status-badge.completed {
    background: rgba(46, 204, 113, 0.2);
    color: #27ae60;
  }

  .status-badge.cancelled {
    background: rgba(231, 76, 60, 0.2);
    color: #c0392b;
  }

  .order-items {
    margin: 2.5rem 0;
  }

  .order-items h3 {
    color: #2c3e50;
    margin-bottom: 1.5rem;
    font-weight: 600;
    display: flex;
    align-items: center;
  }

  .order-items h3:before {
    content: '📦';
    margin-right: 0.5rem;
  }

  .table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }

  .table th {
    background: #f1f4f6;
    padding: 1.2rem;
    text-align: left;
    font-weight: 600;
    color: #2c3e50;
    border-bottom: 2px solid #dee2e6;
  }

  .table th:first-child {
    padding-left: 1.5rem;
  }

  .table th:last-child {
    padding-right: 1.5rem;
  }

  .table td {
    padding: 1.2rem;
    border-bottom: 1px solid #dee2e6;
    vertical-align: middle;
  }

  .table td:first-child {
    padding-left: 1.5rem;
  }

  .table td:last-child {
    padding-right: 1.5rem;
  }

  .table tbody tr {
    transition: all 0.3s ease;
  }

  .table tbody tr:hover {
    background: #f8f9fa;
    transform: scale(1.01);
  }

  .table tbody tr:last-child td {
    border-bottom: none;
  }

  .total {
    text-align: right;
    padding: 2rem;
    background: #f8f9fa;
    border-radius: 12px;
    margin-top: 2.5rem;
    border-right: 5px solid #3498db;
    transition: all 0.3s ease;
  }

  .total:hover {
    transform: translateX(-5px);
  }

  .total p {
    margin: 0;
    font-size: 1.4rem;
  }

  .total p strong {
    color: #2c3e50;
    margin-right: 1rem;
  }

  .total .amount {
    color: #3498db;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .order-details {
      margin: 1rem;
      padding: 1.5rem;
    }

    .order-details h1 {
      font-size: 1.8rem;
    }

    .order-summary {
      padding: 1.5rem;
    }

    .order-summary p {
      flex-direction: column;
      align-items: flex-start;
    }

    .order-summary p strong {
      margin-bottom: 0.3rem;
    }

    .order-summary p strong:after {
      display: none;
    }

    .table {
      display: block;
      overflow-x: auto;
    }

    .table th,
    .table td {
      padding: 1rem;
      white-space: nowrap;
      font-size: 0.9rem;
    }
  }
</style>